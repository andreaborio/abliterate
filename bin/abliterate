#!/usr/bin/env node
"use strict";

// src/commands/brief.ts
var import_node_fs = require("node:fs");
var import_node_path = require("node:path");

// src/util.ts
var import_node_child_process = require("node:child_process");
var VERSION = true ? "0.2.0" : "0.0.0-dev";
var UsageError = class extends Error {
};
var EXIT = { ok: 0, findings: 1, usage: 2, env: 3 };
function parseArgs(argv, booleans = []) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--") {
      out._.push(...argv.slice(i + 1));
      break;
    }
    if (a.startsWith("--")) {
      const [k, v] = a.slice(2).split(/=(.*)/s, 2);
      if (booleans.includes(k)) {
        out[k] = v === void 0 ? true : v !== "false";
        continue;
      }
      const val = v ?? argv[++i];
      if (val === void 0) throw new UsageError(`--${k} needs a value`);
      out[k] = val;
    } else out._.push(a);
  }
  return out;
}
function allowFlags(flags, allowed) {
  for (const k of Object.keys(flags)) if (k !== "_" && !allowed.includes(k)) throw new UsageError(`unknown option --${k}`);
}
var str = (flags, k) => typeof flags[k] === "string" ? flags[k] : void 0;
function safeRef(ref) {
  if (!/^[A-Za-z0-9][A-Za-z0-9._/@{}^~-]{0,199}$/.test(ref) || ref.includes("..")) throw new UsageError(`unsafe git ref: ${ref}`);
  return ref;
}
function git(cwd, args, opts = {}) {
  const r = (0, import_node_child_process.spawnSync)("git", [
    "-c",
    "core.fsmonitor=false",
    "-c",
    "core.hooksPath=/dev/null",
    "-c",
    "diff.external=",
    "-c",
    "core.pager=cat",
    "--no-pager",
    ...args
  ], { cwd, encoding: "utf8", maxBuffer: 256 * 1024 * 1024, env: { ...process.env, GIT_EXTERNAL_DIFF: "", GIT_PAGER: "cat", LC_ALL: "C" } });
  if (r.error) throw new Error(`git not available: ${r.error.message}`);
  if (r.status !== 0 && !opts.allowFail) throw new Error(`git ${args.slice(0, 3).join(" ")} failed: ${(r.stderr || "").trim()}`);
  return r.status === 0 ? r.stdout : "";
}
function print(obj) {
  process.stdout.write(JSON.stringify(obj, null, 2) + "\n");
}

// src/commands/brief.ts
var skillRoot = () => {
  for (const dir of [(0, import_node_path.join)(__dirname, "skills"), (0, import_node_path.join)(__dirname, "..", "skills"), (0, import_node_path.join)(__dirname, "..", "..", "skills")]) if ((0, import_node_fs.existsSync)((0, import_node_path.join)(dir, "abliterate-review", "SKILL.md"))) return dir;
  throw new Error("bundled skill files not found next to the CLI");
};
var read = (...parts) => (0, import_node_fs.readFileSync)((0, import_node_path.join)(skillRoot(), ...parts), "utf8");
function topics() {
  const scope2 = read("abliterate-review", "reference", "review-scope.md").trim();
  const text = read("abliterate-review", "reference", "prompts.md");
  const out = /* @__PURE__ */ new Map();
  for (const block2 of text.split(/\n(?=### )/).slice(1)) {
    const [heading, ...rest] = block2.split("\n");
    const m = /^### (\w+) — (.+)$/.exec(heading.trim());
    if (m) out.set(m[1], { title: m[2], body: scope2 + "\n\n" + rest.join("\n").trim() });
  }
  return out;
}
var SKILL_HELP = `abliterate skill [abliterate-review|abliterate-variants]
  Prints a bundled SKILL.md (default abliterate-review).`;
var PROMPT_HELP = `abliterate prompt [TOPIC]
  Lists the focused prompts, or prints one to paste into your agent.`;
var REVIEW_HELP = `abliterate review [--since BRANCH]
  Prints the pre-push review prompt for your agent, with the base filled in.`;
function skill(flags) {
  allowFlags(flags, []);
  const name = flags._[0] ?? "abliterate-review";
  if (!["abliterate-review", "abliterate-variants"].includes(name)) throw new UsageError("skill name must be abliterate-review or abliterate-variants");
  process.stdout.write(read(name, "SKILL.md"));
  return EXIT.ok;
}
function prompt(flags) {
  allowFlags(flags, []);
  const all = topics();
  const name = flags._[0];
  if (!name) {
    process.stdout.write(`Pick a prompt: abliterate prompt TOPIC
${[...all].map(([k, v]) => `  ${k.padEnd(9)} ${v.title}`).join("\n")}
`);
    return EXIT.ok;
  }
  const t = all.get(name);
  if (!t) throw new UsageError(`unknown topic "${name}"; topics: ${[...all.keys()].join(", ")}`);
  process.stdout.write(t.body.replace(/\{base\}/g, "the base branch").replace(/\{seed\}/g, "the fix or advisory I name") + "\n");
  return EXIT.ok;
}
function review(flags) {
  allowFlags(flags, ["since"]);
  const since = str(flags, "since");
  if (since) safeRef(since);
  const t = topics().get("review");
  process.stdout.write(t.body.replace(/\{base\}/g, since ? `\`${since}\`` : "the base branch").replace(/\{seed\}/g, "") + "\n");
  return EXIT.ok;
}

// src/commands/evidence.ts
var import_node_fs3 = require("node:fs");
var import_node_path3 = require("node:path");

// src/git.ts
var repoRoot = (cwd) => git(cwd, ["rev-parse", "--show-toplevel"]).trim();
function resolveBase(root, explicit) {
  if (explicit) {
    safeRef(explicit);
    if (!git(root, ["rev-parse", "--verify", "--quiet", `${explicit}^{commit}`], { allowFail: true }).trim()) {
      throw new UsageError(`base "${explicit}" is not a commit in this clone (no fetch is done; fetch it yourself or pass another ref)`);
    }
    return explicit;
  }
  const upstream = git(root, ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"], { allowFail: true }).trim();
  for (const candidate of [upstream, "origin/main", "origin/master", "main", "master"].filter(Boolean)) {
    if (git(root, ["rev-parse", "--verify", "--quiet", `${candidate}^{commit}`], { allowFail: true }).trim()) return candidate;
  }
  return void 0;
}
function parseDiff(text) {
  const files = [];
  let cur;
  for (const line2 of text.split("\n")) {
    if (line2.startsWith("diff --git ")) {
      cur = { path: "", status: "modified", hunks: [] };
      files.push(cur);
    } else if (!cur) continue;
    else if (line2.startsWith("new file mode")) cur.status = "added";
    else if (line2.startsWith("deleted file mode")) cur.status = "deleted";
    else if (line2.startsWith("rename from ")) {
      cur.status = "renamed";
      cur.from = line2.slice(12);
    } else if (line2.startsWith("--- ") && cur.status === "deleted") cur.path = line2.slice(4).replace(/^a\//, "");
    else if (line2.startsWith("+++ ") && line2 !== "+++ /dev/null") cur.path = line2.slice(4).replace(/^b\//, "");
    else if (line2.startsWith("@@")) {
      const m = /\+(\d+)(?:,(\d+))? @@/.exec(line2);
      if (m) {
        const len = m[2] === void 0 ? 1 : Number(m[2]);
        if (len > 0) cur.hunks.push([Number(m[1]), len]);
      }
    }
  }
  return files.filter((f) => f.path);
}
var DIFF = ["diff", "--no-ext-diff", "--no-textconv", "--no-color", "--unified=0", "-M"];
function computeScope(cwd, explicitBase) {
  const root = repoRoot(cwd);
  const notes = [];
  const head = git(root, ["rev-parse", "--verify", "--quiet", "HEAD"], { allowFail: true }).trim() || void 0;
  const base = resolveBase(root, explicitBase);
  let mergeBase;
  let push = [];
  let commits = [];
  if (!head) notes.push("No commits yet: only index and working tree can be reviewed.");
  else if (!base) notes.push("No base found (no upstream, main or master): the push state was not computed. Pass --base.");
  else {
    mergeBase = git(root, ["merge-base", base, "HEAD"], { allowFail: true }).trim() || void 0;
    if (!mergeBase) notes.push(`No common ancestor between ${base} and HEAD (shallow or unrelated history): push state not computed.`);
    else {
      push = parseDiff(git(root, ["-c", "core.quotePath=false", ...DIFF, mergeBase, "HEAD"]));
      commits = git(root, ["log", "--format=%H%x09%s", `${mergeBase}..HEAD`]).trim().split("\n").filter(Boolean).map((l) => {
        const [sha, ...s] = l.split("	");
        return { sha, subject: s.join("	") };
      });
    }
    if (git(root, ["rev-parse", "--is-shallow-repository"]).trim() === "true") notes.push("Shallow clone: history-based checks may be incomplete.");
  }
  const index = head ? parseDiff(git(root, ["-c", "core.quotePath=false", ...DIFF, "--cached"])) : [];
  const worktree = parseDiff(git(root, ["-c", "core.quotePath=false", ...DIFF]));
  const untracked = git(root, ["-c", "core.quotePath=false", "ls-files", "--others", "--exclude-standard"]).split("\n").filter(Boolean);
  return { root, base, mergeBase, head, commits, states: { push, index, worktree }, untracked, notes };
}
function readAt(root, state, path) {
  const spec = state === "push" ? `HEAD:${path}` : `:${path}`;
  const out = git(root, ["cat-file", "-p", spec], { allowFail: true });
  return out || void 0;
}
var trackedFiles = (root) => git(root, ["-c", "core.quotePath=false", "ls-files"]).split("\n").filter(Boolean);

// src/lang.ts
var EXT = {
  js: "js",
  jsx: "js",
  mjs: "js",
  cjs: "js",
  ts: "js",
  tsx: "js",
  mts: "js",
  cts: "js",
  vue: "js",
  svelte: "js",
  py: "py",
  go: "go",
  java: "java",
  kt: "java",
  scala: "java",
  rb: "rb",
  erb: "rb",
  php: "php",
  blade: "php",
  yml: "yaml",
  yaml: "yaml"
};
function langOf(path) {
  const m = /\.([A-Za-z0-9]+)$/.exec(path);
  return m && EXT[m[1].toLowerCase()] || "other";
}
var SKIP = /(^|\/)(node_modules|vendor|dist|build|out|\.next|coverage|target|__pycache__|\.venv|venv|bower_components)\/|\.min\.(js|css)$|\.map$|(^|\/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml)$/;
var skipPath = (p) => SKIP.test(p);
var MAX_BYTES = 1e6;
function stripComments(text, lang) {
  if (lang === "other") return text;
  const hash = lang === "py" || lang === "rb" || lang === "yaml" || lang === "php";
  const slash = lang !== "py" && lang !== "rb" && lang !== "yaml";
  const out = text.split("");
  let i = 0;
  let quote = null;
  const blank = (from, to) => {
    for (let k = from; k < to; k++) if (out[k] !== "\n") out[k] = " ";
  };
  while (i < text.length) {
    const c = text[i];
    if (quote) {
      if (c === "\\") {
        i += 2;
        continue;
      }
      if (text.startsWith(quote, i)) {
        i += quote.length;
        quote = null;
        continue;
      }
      if (quote.length === 1 && quote !== "`" && c === "\n") quote = null;
      i++;
      continue;
    }
    if (lang === "py" && (text.startsWith('"""', i) || text.startsWith("'''", i))) {
      quote = text.slice(i, i + 3);
      i += 3;
      continue;
    }
    if (c === '"' || c === "'" || c === "`" && (lang === "js" || lang === "go")) {
      quote = c;
      i++;
      continue;
    }
    if (slash && c === "/" && text[i + 1] === "/") {
      const end = text.indexOf("\n", i);
      blank(i, end < 0 ? text.length : end);
      i = end < 0 ? text.length : end;
      continue;
    }
    if (slash && c === "/" && text[i + 1] === "*") {
      const end = text.indexOf("*/", i + 2);
      const stop = end < 0 ? text.length : end + 2;
      blank(i, stop);
      i = stop;
      continue;
    }
    if (hash && c === "#" && !(lang === "yaml" && /\$\{\{[^}]*$/.test(text.slice(text.lastIndexOf("\n", i) + 1, i)))) {
      const end = text.indexOf("\n", i);
      blank(i, end < 0 ? text.length : end);
      i = end < 0 ? text.length : end;
      continue;
    }
    i++;
  }
  return out.join("");
}

// src/rules.ts
var SQL = /\b(select|insert\s+into|update\s+\w+\s+set|delete\s+from|where|order\s+by|union)\b/i;
var JS_SOURCE = /\breq(?:uest)?\.(query|body|params|headers|cookies)\b|\bctx\.(query|request\.body|params)\b|\bsearchParams\.get\(|\bformData\.get\(/;
var PY_SOURCE = /\brequest\.(args|form|values|json|get_json|data|files|GET|POST|body|query_params|path_params|cookies|headers)\b/;
var ESCAPED = /^\s*(escape|esc|encode\w*|sanitize\w*|DOMPurify\.sanitize|purify|xss|he\.encode|htmlEscape|escapeHtml|_\.escape|String\(Number)/;
function blockOf(ctx, i) {
  const lines = ctx.code;
  if (ctx.lang === "py" || ctx.lang === "rb" || ctx.lang === "yaml") {
    const indent = (s) => s.length - s.trimStart().length;
    const opener = ctx.lang === "py" ? /^\s*(async\s+)?(def|class)\s/ : ctx.lang === "rb" ? /^\s*(def|class|module)\s/ : /^\S/;
    let def = -1;
    for (let k = i; k >= 0; k--) {
      if (opener.test(lines[k]) && (k === i || indent(lines[k]) < indent(lines[i]))) {
        def = k;
        break;
      }
    }
    if (def < 0) return [Math.max(0, i - 15), Math.min(lines.length - 1, i + 15)];
    const base = indent(lines[def]);
    let end2 = Math.max(def, i);
    for (let k = def + 1; k < lines.length; k++) {
      if (lines[k].trim() === "") continue;
      if (indent(lines[k]) <= base) break;
      end2 = k;
    }
    let start2 = def;
    while (start2 > 0 && /^\s*@/.test(lines[start2 - 1])) start2--;
    return [start2, Math.max(end2, i)];
  }
  let start = i;
  for (let k = i; k >= Math.max(0, i - 80); k--) {
    if (/(=>\s*\{|\bfunction\b[^;]*\{|\)\s*\{\s*$|\bfunc\b[^;]*\{)/.test(lines[k])) {
      start = k;
      break;
    }
  }
  let depth = 0;
  let end = i;
  for (let k = start; k < Math.min(lines.length, start + 200); k++) {
    for (const ch of lines[k]) {
      if (ch === "{") depth++;
      else if (ch === "}") depth--;
    }
    end = k;
    if (depth <= 0 && k > start) break;
  }
  return [start, Math.max(end, i)];
}
function taintedNames(ctx, from, to, source) {
  const names = /* @__PURE__ */ new Set();
  for (let k = from; k <= to; k++) {
    const l = ctx.code[k];
    if (!source.test(l)) continue;
    const destructured = /(?:const|let|var)\s*\{([^}]+)\}\s*=/.exec(l);
    if (destructured) destructured[1].split(",").forEach((n) => names.add(n.split(":").pop().trim().split("=")[0].trim()));
    const simple = /(?:const|let|var|final|\bString)?\s*([A-Za-z_$][\w$]*)\s*(?::\s*[\w<>[\]| ]+)?=(?!=)/.exec(l);
    if (simple && !/^(if|while|return)$/.test(simple[1])) names.add(simple[1]);
    const tuple = /^\s*([A-Za-z_]\w*(?:\s*,\s*[A-Za-z_]\w*)+)\s*=(?!=)/.exec(l);
    if (tuple) tuple[1].split(",").forEach((n) => names.add(n.trim()));
  }
  names.delete("");
  return names;
}
var mentions = (text, names) => [...names].some((n) => new RegExp(`(^|[^\\w$.])${n.replace(/\$/g, "\\$")}\\b`).test(text));
function lineRule(def) {
  return {
    ...def,
    match(ctx) {
      const hits = [];
      const lines = def.raw ? ctx.raw : ctx.code;
      lines.forEach((l, i) => {
        if (!def.re.test(l) || def.unless?.test(l) || def.needs && !def.needs(l, ctx, i)) return;
        let guarded;
        if (def.guard) {
          const [s, e] = blockOf(ctx, i);
          const g = ctx.code.slice(s, e + 1).join("\n").match(def.guard);
          if (g) guarded = g[0].trim().slice(0, 80);
        }
        hits.push({ line: i + 1, ...guarded ? { guarded } : {} });
      });
      return hits;
    }
  };
}
function taintRule(def) {
  return lineRule({
    ...def,
    re: def.sink,
    needs: (line2, ctx, i) => {
      if (def.source.test(line2)) return true;
      const [s] = blockOf(ctx, i);
      const names = taintedNames(ctx, s, i, def.source);
      const call = line2.slice(line2.search(def.sink));
      return mentions(call, names);
    }
  });
}
