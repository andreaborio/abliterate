// src/scan.ts
var import_node_fs2 = require("node:fs");
var import_node_path2 = require("node:path");
var SECRET_RULE = "any.secret.credential-literal";
function redact(text) {
  return text.replace(/([A-Za-z0-9_-]{4})[A-Za-z0-9_/+=.-]{8,}/g, (m, keep) => m.length >= 16 ? `${keep}\u2026[redacted]` : m);
}
function snippet(line2, rule) {
  const t = line2.trim().replace(/\s+/g, " ");
  const s = rule === SECRET_RULE ? redact(t) : t;
  return s.length > 200 ? s.slice(0, 197) + "\u2026" : s;
}
function readDisk(root, path) {
  try {
    const p = (0, import_node_path2.join)(root, path);
    const st = (0, import_node_fs2.statSync)(p);
    if (!st.isFile() || st.size > MAX_BYTES) return void 0;
    const text = (0, import_node_fs2.readFileSync)(p, "utf8");
    return text.includes("\0") ? void 0 : text;
  } catch {
    return void 0;
  }
}
function scanText(path, text, rules = RULES) {
  const lang = langOf(path);
  const raw = text.split(/\r?\n/);
  const ctx = { path, lang, raw, code: stripComments(text, lang).split(/\r?\n/) };
  const out = [];
  for (const rule of rules) {
    if (rule.files ? !rule.files.test(path) : rule.langs !== "any" && !rule.langs.includes(lang)) continue;
    if (rule.files && rule.langs !== "any" && !rule.langs.includes(lang)) continue;
    for (const h of rule.match(ctx)) out.push({ rule, ...h });
  }
  return { raw, hits: out };
}
var inHunks = (hunks, line2) => !!hunks?.some(([s, n]) => line2 >= s && line2 < s + n);
function scan(cwd, opts) {
  const scope2 = computeScope(cwd, opts.base);
  const { root, states } = scope2;
  const byState = (s) => new Map(states[s].filter((f) => f.status !== "deleted").map((f) => [f.path, f.hunks]));
  const push = byState("push");
  const index = byState("index");
  const work = byState("worktree");
  const untracked = new Set(scope2.untracked);
  const files = new Set(
    opts.changedOnly ? [...push.keys(), ...index.keys(), ...work.keys(), ...untracked] : [...trackedFiles(root), ...untracked]
  );
  const seen = /* @__PURE__ */ new Set();
  const candidates = [];
  const guarded = [];
  const emit = (path, text, where, onlyChanged) => {
    const { raw, hits } = scanText(path, text, opts.rules);
    for (const h of hits) {
      const changedIn = where(h.line);
      if (onlyChanged && changedIn === null) continue;
      const key2 = `${h.rule.id}|${path}|${h.line}|${changedIn}`;
      if (seen.has(key2)) continue;
      seen.add(key2);
      const c = {
        rule: h.rule.id,
        cwe: h.rule.cwe,
        title: h.rule.title,
        confidence: h.rule.confidence,
        path,
        line: h.line,
        changedIn,
        snippet: snippet(raw[h.line - 1] ?? "", h.rule.id),
        ...h.guarded ? { guarded: h.guarded } : {},
        ...h.note ? { note: h.note } : {}
      };
      (h.guarded ? guarded : candidates).push(c);
    }
  };
  let scanned = 0;
  for (const path of [...files].sort()) {
    if (skipPath(path)) continue;
    const disk = readDisk(root, path);
    const localEdits = index.has(path) || work.has(path);
    if (untracked.has(path)) {
      if (disk !== void 0) {
        emit(path, disk, () => "untracked", false);
        scanned++;
      }
      continue;
    }
    if (!localEdits) {
      if (disk !== void 0) {
        emit(path, disk, (l) => inHunks(push.get(path), l) ? "push" : null, false);
        scanned++;
      }
      continue;
    }
    if (push.has(path)) {
      const t = readAt(root, "push", path);
      if (t !== void 0) emit(path, t, (l) => inHunks(push.get(path), l) ? "push" : null, true);
    }
    if (index.has(path)) {
      const t = readAt(root, "index", path);
      if (t !== void 0) emit(path, t, (l) => inHunks(index.get(path), l) ? "index" : null, true);
    }
    if (disk !== void 0) emit(path, disk, (l) => inHunks(work.get(path), l) ? "worktree" : null, false);
    scanned++;
  }
  const order = (c) => c.changedIn ? 0 : 1;
  const conf = { high: 0, medium: 1, low: 2 };
  const sort = (a, b) => order(a) - order(b) || conf[a.confidence] - conf[b.confidence] || a.path.localeCompare(b.path) || a.line - b.line;
  return { scope: scope2, candidates: candidates.sort(sort), guarded: guarded.sort(sort), files: scanned };
}

// src/surface.ts
var GUARD_NAME = /\b(login_required|permission_required|user_passes_test|staff_member_required|requires_auth|auth\w*|authenticate\w*|authorize\w*|require\w*(Auth|User|Admin|Role|Login|Permission)\w*|isAuthenticated|ensureLoggedIn|protect\w*|verify\w*Token|jwtCheck|passport\.authenticate|Depends\(\s*get_current\w*|Depends\(\s*\w*(auth|user)\w*|PreAuthorize|Secured|RolesAllowed|before_action\s+:authenticate\w*|middleware\(\s*['"]auth[\w:'",\s]*\)|can\(|policy|Policy|current_user)\b/g;
var guardsIn = (text) => [...new Set(text.match(GUARD_NAME) ?? [])].slice(0, 6);
function entryPoints(path, text) {
  if (skipPath(path)) return [];
  const lang = langOf(path);
  const lines = stripComments(text, lang).split(/\r?\n/);
  const out = [];
  const push = (e) => out.push({ path, ...e });
  if (lang === "js") {
    const nextRoute = /(^|\/)(app|src\/app)\/(.+)\/route\.(t|j)sx?$/.exec(path);
    const pagesApi = /(^|\/)(pages|src\/pages)\/api\/(.+)\.(t|j)sx?$/.exec(path);
    lines.forEach((l, i) => {
      const express = /\b(app|router|server|api|routes?|fastify|r)\.(get|post|put|patch|delete|all|options|head)\s*\(\s*(['"`])([^'"`]+)\3([^;]*)/.exec(l);
      if (express) push({ kind: "http", framework: "express-like", method: express[2].toUpperCase(), route: express[4], line: i + 1, guards: guardsIn(express[5]) });
      if (nextRoute) {
        const m = /export\s+(async\s+)?(function|const)\s+(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\b/.exec(l);
        if (m) push({ kind: "http", framework: "next-app-router", method: m[3], route: "/" + nextRoute[3].replace(/\(([^)]+)\)\//g, ""), line: i + 1, guards: guardsIn(lines.slice(i, i + 15).join("\n")) });
      }
      if (pagesApi && /export\s+default\b/.test(l)) push({ kind: "http", framework: "next-pages-api", route: "/api/" + pagesApi[3], line: i + 1, guards: guardsIn(lines.slice(i, i + 15).join("\n")) });
      if (/^\s*["']use server["']/.test(l)) push({ kind: "server-action", framework: "next-server-action", line: i + 1, guards: guardsIn(lines.slice(i, i + 40).join("\n")) });
      const q = /\bnew\s+Worker\s*\(\s*['"`]([^'"`]+)|\.process\s*\(\s*['"`]([^'"`]+)|cron\.schedule\s*\(/.exec(l);
      if (q) push({ kind: "job", framework: "queue/cron", route: q[1] ?? q[2], line: i + 1, guards: [] });
      if (/webhook/i.test(l) && express) out[out.length - 1].kind = "webhook";
    });
  } else if (lang === "py") {
    lines.forEach((l, i) => {
      const flask = /@\s*(\w+)\.(route|get|post|put|patch|delete|api_route|websocket)\s*\(\s*["']([^"']+)["']([^\n]*)/.exec(l);
      if (flask) {
        const methods = /methods\s*=\s*\[([^\]]+)\]/.exec(flask[4])?.[1]?.replace(/["'\s]/g, "");
        let k = i + 1;
        const decl = [l];
        while (k < lines.length && k < i + 12) {
          decl.push(lines[k]);
          if (/^\s*(async\s+)?def\s/.test(lines[k])) {
            decl.push(lines[k + 1] ?? "");
            break;
          }
          k++;
        }
        const method = flask[2] === "route" ? methods ?? "GET" : flask[2].toUpperCase();
        push({ kind: "http", framework: /Depends|APIRouter|FastAPI/.test(text) ? "fastapi" : "flask", method, route: flask[3], line: i + 1, guards: guardsIn(decl.join("\n")) });
      }
      const django = /\b(re_)?path\s*\(\s*r?["']([^"']*)["']\s*,\s*([\w.]+)/.exec(l);
      if (django && /urls\.py$/.test(path)) push({ kind: "http", framework: "django", route: "/" + django[2], line: i + 1, guards: guardsIn(l) });
      if (/@(shared_task|app\.task|celery\.task|dramatiq\.actor)\b/.test(l)) push({ kind: "job", framework: "celery/dramatiq", line: i + 1, guards: [] });
    });
  } else if (lang === "java") {
    lines.forEach((l, i) => {
      const m = /@(Get|Post|Put|Patch|Delete|Request)Mapping\s*(\(\s*(value\s*=\s*)?\{?\s*"([^"]*)")?/.exec(l);
      if (m) push({ kind: "http", framework: "spring", method: m[1] === "Request" ? void 0 : m[1].toUpperCase(), route: m[4], line: i + 1, guards: guardsIn(lines.slice(Math.max(0, i - 4), i + 1).join("\n")) });
    });
  } else if (lang === "go") {
    lines.forEach((l, i) => {
      const m = /\.(HandleFunc|Handle|GET|POST|PUT|PATCH|DELETE|Get|Post|Put|Patch|Delete|Any)\s*\(\s*"([^"]+)"([^\n]*)/.exec(l);
      if (m) push({ kind: "http", framework: "go-http", method: /Handle/.test(m[1]) ? void 0 : m[1].toUpperCase(), route: m[2], line: i + 1, guards: guardsIn(m[3]) });
    });
  } else if (lang === "rb" && /config\/routes\.rb$/.test(path)) {
    lines.forEach((l, i) => {
      const m = /^\s*(get|post|put|patch|delete|resources?|match)\s+["':]?([\w/:.-]+)/.exec(l);
      if (m) push({ kind: "http", framework: "rails", method: /^(get|post|put|patch|delete)$/.test(m[1]) ? m[1].toUpperCase() : void 0, route: m[2], line: i + 1, guards: [] });
    });
  } else if (lang === "php") {
    lines.forEach((l, i) => {
      const m = /Route::(get|post|put|patch|delete|any|match|resource|apiResource)\s*\(\s*['"]([^'"]+)['"]([^;]*)/.exec(l);
      if (m) push({ kind: "http", framework: "laravel", method: m[1].toUpperCase(), route: m[2], line: i + 1, guards: guardsIn(m[3]) });
    });
  } else if (lang === "yaml" && /(^|\/)\.github\/workflows\//.test(path)) {
    lines.forEach((l, i) => {
      const m = /^\s*(-\s*)?(pull_request_target|pull_request|push|workflow_run|issue_comment|issues|workflow_dispatch|schedule|release|discussion_comment|pull_request_review_comment)\s*:?\s*$|^\s*on\s*:\s*\[?([\w, ]+)\]?\s*$/.exec(l);
      if (m) push({ kind: "ci-trigger", framework: "github-actions", route: m[2] ?? m[3]?.trim(), line: i + 1, guards: [] });
    });
  }
  return out;
}

// src/commands/evidence.ts
var SCOPE_HELP = `abliterate scope [--base REF]
  Verified review states: commits since the merge-base (push), staged (index), unstaged (worktree), untracked.
  Never fetches or changes branches; diff drivers and textconv are disabled.`;
var SINKS_HELP = `abliterate sinks [--base REF] [--changed] [--include-guarded] [--rule ID,...] [--format json|md]
  Candidate vulnerable code by CWE, each marked with the snapshot that changed it (push, index, worktree,
  untracked) or null when it predates the change. Candidates must be traced and confirmed; they are not findings.`;
var SURFACE_HELP = `abliterate surface [--base REF] [--changed] [--format json|md]
  Entry points (HTTP routes, server actions, jobs, webhooks, CI triggers) and the auth names on each declaration.`;
function scope(flags, cwd) {
  allowFlags(flags, ["base"]);
  print(computeScope(cwd, str(flags, "base")));
  return EXIT.ok;
}
var fmt = (flags) => {
  const f = str(flags, "format") ?? "json";
  if (f !== "json" && f !== "md") throw new UsageError("--format must be json or md");
  return f;
};
function candidatesMd(cs, guarded) {
  const row = (c) => `| ${c.changedIn ?? "before"} | ${c.cwe} | \`${c.path}:${c.line}\` | ${c.rule} | ${c.confidence} | \`${c.snippet.replace(/\|/g, "\\|").replace(/`/g, "'")}\` |`;
  const out = ["| changed in | CWE | location | rule | confidence | code |", "| --- | --- | --- | --- | --- | --- |", ...cs.map(row)];
  if (guarded.length) out.push("", `${guarded.length} more candidate(s) had a recognised guard in the same block; rerun with --include-guarded to list them.`);
  return out.join("\n") + "\n";
}
function sinks(flags, cwd) {
  allowFlags(flags, ["base", "changed", "include-guarded", "rule", "format"]);
  const format = fmt(flags);
  const ids = str(flags, "rule")?.split(",").map((s) => s.trim()).filter(Boolean);
  const rules = ids ? RULES.filter((r2) => ids.includes(r2.id)) : RULES;
  if (ids && rules.length !== ids.length) throw new UsageError(`unknown rule id in --rule; known: ${RULES.map((r2) => r2.id).join(", ")}`);
  const r = scan(cwd, { base: str(flags, "base"), changedOnly: flags.changed === true, rules });
  const includeGuarded = flags["include-guarded"] === true;
  if (format === "md") {
    process.stdout.write(candidatesMd(includeGuarded ? [...r.candidates, ...r.guarded] : r.candidates, includeGuarded ? [] : r.guarded));
    return EXIT.ok;
  }
  print({
    base: r.scope.base ?? null,
    mergeBase: r.scope.mergeBase ?? null,
    head: r.scope.head ?? null,
    notes: r.scope.notes,
    filesScanned: r.files,
    candidates: r.candidates,
    ...includeGuarded ? { guarded: r.guarded } : { guardedCount: r.guarded.length },
    reminder: "Candidates are leads. Trace each from source to sink, look for the guard on that path, and try to disprove it before reporting."
  });
  return EXIT.ok;
}
function surface(flags, cwd) {
  allowFlags(flags, ["base", "changed", "format"]);
  const format = fmt(flags);
  const sc = computeScope(cwd, str(flags, "base"));
  const changed = /* @__PURE__ */ new Map();
  for (const s of ["push", "index", "worktree"]) for (const f of sc.states[s]) changed.set(f.path, [...changed.get(f.path) ?? [], ...f.hunks]);
  for (const u of sc.untracked) changed.set(u, [[1, Number.MAX_SAFE_INTEGER]]);
  const files = flags.changed === true ? [...changed.keys()] : [.../* @__PURE__ */ new Set([...trackedFiles(sc.root), ...sc.untracked])];
  const eps = [];
  for (const path of files.sort()) {
    let text;
    try {
      const p = (0, import_node_path3.join)(sc.root, path);
      if ((0, import_node_fs3.statSync)(p).size > MAX_BYTES) continue;
      text = (0, import_node_fs3.readFileSync)(p, "utf8");
    } catch {
      continue;
    }
    for (const e of entryPoints(path, text)) {
      const hunks = changed.get(path);
      eps.push({ ...e, changed: !!hunks?.some(([s, n]) => e.line >= s && e.line < s + n) });
    }
  }
  if (format === "md") {
    process.stdout.write([
      "| changed | kind | method | route | location | guards on declaration |",
      "| --- | --- | --- | --- | --- | --- |",
      ...eps.map((e) => `| ${e.changed ? "yes" : ""} | ${e.kind} | ${e.method ?? ""} | ${e.route ?? ""} | \`${e.path}:${e.line}\` | ${e.guards.join(", ") || "none seen"} |`)
    ].join("\n") + "\n");
    return EXIT.ok;
  }
  print({ entryPoints: eps, note: "Guards listed are names on the declaration only; global middleware and policies elsewhere must be checked in the code." });
  return EXIT.ok;
}

// src/commands/deps.ts
var import_node_fs6 = require("node:fs");
